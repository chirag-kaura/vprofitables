# GANN-ASTRO Environment Configuration
# Copy this file to '.env' and fill in your values.

# Server Configuration
GANN_PORT=5050

# JWT Security (used for signing login sessions)
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-change-before-production-do-not-use-in-prod

# Google OAuth Client ID (Get this from Google Cloud Console under Credentials)
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Initial Admin User Credentials
# Seeded automatically into database on first run
ADMIN_EMAIL=chiragkaura2003@gmail.com
ADMIN_PASSWORD=admin_secret_change_me
